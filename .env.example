APP_NAME="Blog Sederhana"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://<IP_PUBLIC_VM>

LOG_CHANNEL=stderr
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=database
DB_PORT=3306
DB_DATABASE=blog_db
DB_USERNAME=blog_user
DB_PASSWORD=blog_password_secret
MYSQL_ROOT_PASSWORD=mysql_root_secret

RUN_MIGRATIONS=true
RUN_SEEDERS=true

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database
